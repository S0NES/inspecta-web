# ============================================================================
# inspecta-web/.env.prod — copie para .env.prod na VPS e preencha.
#   cp .env.prod.example .env.prod && nano .env.prod
# NUNCA commitar .env.prod.
#
# ATENÇÃO: o deploy de produção do inspecta-web passou a ser Cloudflare Pages, não este
# compose/Traefik (ver DEPLOY_DOKPLOY.md § Cloudflare Pages) — lá o único valor
# que importa é a mesma VITE_API_BASE_URL abaixo, configurada como env var de
# build no painel do Cloudflare Pages. Este arquivo/compose continua valendo
# para quem quiser rodar o inspecta-web via Docker localmente ou como alternativa
# self-hosted ao Pages.
# ============================================================================

# --- Roteamento / Traefik (só se estiver usando este compose, não o Pages) --
APP_HOST=app.inspectavistorias.com.br
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- API base URL (BUILD-TIME — mudou aqui, precisa rebuildar) -------------
# inspecta-web e inspecta-api não são mais same-origin (inspecta-web no Cloudflare Pages, inspecta-api no
# Dokploy) — aponta direto pro domínio da API. O inspecta-api aceita CORS em prod
# para esta origem via CORS_ALLOWED_ORIGINS (ver inspecta-api/.env.prod.example).
VITE_API_BASE_URL=https://api.inspecta.viniciusscarabelli.tech

# --- Runtime ---------------------------------------------------------------
IMAGE_TAG=latest
WEB_MEM_LIMIT=128m
TZ=America/Sao_Paulo
